{
  "name": "dogfood",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:chrome": "pnpm run bench:chrome:mixed; mixed=$?; pnpm run bench:chrome:tracked; tracked=$?; test $mixed -eq 0 -a $tracked -eq 0",
    "bench:chrome:mixed": "node bench-chrome.mjs --stream=mixed",
    "bench:chrome:tracked": "node bench-chrome.mjs --stream=tracked-source",
    "bench:chrome:interleaved": "node bench-chrome-interleaved.mjs",
    "collect": "node collect.mjs",
    "probe:recording": "node recording-probe.mjs",
    "probe:explanation-state": "node explanation-state-probe.mjs",
    "probe:command-capture": "node command-capture-probe.mjs",
    "probe:explanation-overlay": "node explanation-overlay-probe.mjs",
    "probe:command-capture:test": "node --test command-capture-truth.test.mjs",
    "probe:draw-callsite": "node draw-callsite-probe.mjs",
    "probe:draw-callsite:check": "node draw-callsite-probe.mjs --check-evidence /private/tmp/sidproj-68-draw-callsite-evidence",
    "probe:draw-callsite:test": "node --test draw-callsite-truth.test.mjs",
    "probe:reset": "node probes.mjs",
    "probe:burst-heavy": "node burst-heavy-probe.mjs",
    "probe:continuous-repeated": "node v04-04-continuous-probe.mjs",
    "probe:resize-churn": "node v04-05-resize-churn-probe.mjs",
    "probe:backing-store": "node v04-06-backing-store-probe.mjs",
    "probe:lifecycle": "node v04-07-lifecycle-probe.mjs",
    "probe:associations": "node v04-08-associations-probe.mjs",
    "probe:findings": "node v04-09-findings-probe.mjs",
    "probe:v0.4": "node probe-v04.mjs",
    "lab:v0.4": "node lab-v04.mjs",
    "lab:v0.4:check": "node lab-v04.mjs --check-evidence",
    "lab:v0.4:test": "node --test lab-v04.test.mjs",
    "release:v0.4:test": "node --test bench-chrome-interleaved.test.mjs release-v04.test.mjs",
    "release:v0.4:check": "node release-v04.mjs --check-evidence"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0"
  }
}
