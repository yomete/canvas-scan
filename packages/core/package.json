{
  "name": "canvas-scan",
  "version": "0.7.3",
  "description": "Drop-in Canvas2D investigation for observable main-thread canvas work.",
  "type": "module",
  "license": "MIT",
  "repository": "github:yomete/canvas-scan",
  "keywords": [
    "react",
    "canvas",
    "performance",
    "devtools",
    "profiling"
  ],
  "bin": {
    "canvas-scan": "./bin/canvas-scan.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./auto": "./src/auto.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./auto": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      }
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts src/auto.ts --bundle --splitting --format=esm --outdir=dist --external:bippy && esbuild src/auto.ts --bundle --format=iife --outfile=dist/canvas-scan.iife.js --minify && tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "bippy": "0.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
